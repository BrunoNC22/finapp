{
  "name": "finapp",
  "private": true,
  "license": "MIT",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "pnpm build:packages && pnpm -r test",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "build": "pnpm -r build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "arch": "depcruise apps/api/src --config .dependency-cruiser.cjs",
    "check": "pnpm lint && pnpm arch && pnpm typecheck && pnpm test",
    "build:packages": "pnpm -r --filter './packages/*' build",
    "demo": "docker compose -f compose.demo.yaml up -d --build --wait && printf '\\nfinapp (demonstração) em http://localhost:8090\\nA senha aparece na tela de login. Para desligar e apagar tudo: corepack pnpm demo:down\\n'",
    "demo:down": "docker compose -f compose.demo.yaml down --volumes"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "dependency-cruiser": "^18.7.2"
  }
}
