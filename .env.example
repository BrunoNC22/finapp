# Copie para .env e preencha. O .env NUNCA é versionado.

# --- Cofre LUKS (dados em repouso) — usado por scripts/vault.sh ---
FINAPP_VAULT_FILE=/caminho/para/finapp.luks
FINAPP_VAULT_MOUNT=/caminho/para/ponto-de-montagem
FINAPP_VAULT_SIZE=8G
# UID/GID do usuário dono dos dados (o Mongo roda com ele)
FINAPP_UID=1000
FINAPP_GID=1000

# --- MongoDB ---
MONGO_ROOT_USER=finapp
MONGO_ROOT_PASSWORD=troque-por-uma-senha-forte
# Usuário da aplicação (só leitura/escrita no banco da app). Criado por scripts/mongo-app-user.sh
MONGO_APP_USER=finapp_app
MONGO_APP_PASSWORD=troque-por-outra-senha-forte

# --- Backup (restic) — usado por scripts/backup.sh ---
RESTIC_REPOSITORY=/caminho/para/repositorio-restic
RESTIC_PASSWORD_FILE=/caminho/para/restic-password

# --- API ---
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Open Finance ---
# demo   → dados sintéticos gerados localmente (não precisa de conta em lugar nenhum)
# pluggy → suas contas reais via Meu Pluggy
OPEN_FINANCE_PROVIDER=demo
# Sincronização automática (horas; 0 desliga)
SYNC_INTERVAL_HOURS=6

# --- Login (estilo app de banco) ---
# Sessão expira após N minutos sem uso, e no máximo após N horas
SESSION_IDLE_MINUTES=10
SESSION_MAX_HOURS=12
# Digital (passkey/WebAuthn): domínio e origem exatos onde o app é aberto
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# IDs dos items (um por instituição), copiados do dashboard da Pluggy, separados por vírgula
PLUGGY_ITEM_IDS=
